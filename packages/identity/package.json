{
  "name": "@meltemi/identity",
  "version": "0.2.0",
  "description": "The shared identity service of the Meltemi family: GitHub and Google sign-in, signed sessions, and the reference verifier products use.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "meltemi",
    "session",
    "jwt",
    "es256",
    "verifier"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askenaz-dev/meltemi-web.git",
    "directory": "packages/identity"
  },
  "homepage": "https://github.com/askenaz-dev/meltemi-web/tree/main/packages/identity#readme",
  "bugs": {
    "url": "https://github.com/askenaz-dev/meltemi-web/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "dev": "wrangler dev",
    "migrate": "wrangler d1 migrations apply DB"
  }
}
