{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "meltemi-site",
  "compatibility_date": "2026-09-15",
  "dev": { "port": 8789 },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
