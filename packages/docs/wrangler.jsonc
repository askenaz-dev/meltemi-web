{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The portal (design decision 5): the build's static pages as assets, and one route of code,
  // `POST /api/ask`. Terraform declares the Worker and its Custom Domain docs.meltemi.dev; this file
  // holds no route and no address of its own.
  "name": "meltemi-docs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  "dev": { "port": 8790 },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "ASK_LIMIT", "namespace_id": "1", "simple": { "limit": 10, "period": 60 } },
  ],
}
