# Terraform's local files: the providers' cache, any state, plans and variable values. The lock
# file of the providers (.terraform.lock.hcl) is committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.auto.tfvars.example
